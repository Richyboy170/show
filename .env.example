# ===========================================
# THAI LYRICS APP - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="file:./dev.db"

# ===========================================
# NEXTAUTH AUTHENTICATION
# ===========================================
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here"

# ===========================================
# GOOGLE OAUTH (Required for user login)
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# ADMIN CREDENTIALS
# ===========================================
ADMIN_EMAIL="your-admin-email@example.com"
# Generate with: npm run setup:admin
ADMIN_PASSWORD="your-hashed-password"

# ===========================================
# YOUTUBE API (Required for video metadata)
# ===========================================
YOUTUBE_API_KEY="your-youtube-api-key"
YOUTUBE_CHANNEL_ID="optional-channel-id-for-monitoring"

# ===========================================
# AI PROVIDERS - MUSIC GENERATION
# ===========================================
# You need AT LEAST ONE of these for piano notes & chord generation
# The system will automatically try providers in order and fallback if one fails

# --- OpenAI (Recommended - Best Quality) ---
# Get key from: https://platform.openai.com/api-keys
# Cost: GPT-4o ~$15/1M tokens, GPT-4o-mini ~$0.60/1M tokens
OPENAI_API_KEY="sk-..."
# Optional: Add backup accounts for automatic fallback
OPENAI_API_KEY_2="sk-..."
OPENAI_API_KEY_3="sk-..."

# --- Anthropic Claude (Excellent Alternative) ---
# Get key from: https://console.anthropic.com/
# Cost: Claude Sonnet ~$3/1M tokens, Claude Haiku ~$0.80/1M tokens
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: Add backup account
ANTHROPIC_API_KEY_2="sk-ant-..."

# --- Google Gemini (Good Fallback) ---
# Get key from: https://makersuite.google.com/app/apikey
# Cost: Gemini Pro ~$0.50/1M tokens, Gemini Flash ~$0.15/1M tokens
GEMINI_API_KEY="AIza..."
# Alternative env var name (both work)
GOOGLE_API_KEY="AIza..."

# --- Groq (FREE & FAST!) ---
# Get key from: https://console.groq.com/
# Cost: FREE (with rate limits)
# Speed: 10-20x faster than OpenAI
GROQ_API_KEY="gsk_..."
# Optional: Add backup account
GROQ_API_KEY_2="gsk_..."

# ===========================================
# AI PROVIDERS - TRANSCRIPTION
# ===========================================
# Same keys as above work for transcription
# Groq is especially recommended for transcription (free + super fast)

# ===========================================
# FIREBASE (Optional - for production)
# ===========================================
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="your-client-email@project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ===========================================
# PRIORITY & FALLBACK STRATEGY
# ===========================================
# Piano Notes Generation (Quality-first):
#   1. OpenAI GPT-4o (highest quality)
#   2. Claude Sonnet 4.5 (excellent quality)
#   3. Gemini Pro (good quality)
#   4. OpenAI GPT-4o-mini (cheaper)
#   5. Claude Haiku (cheapest)
#   6. Gemini Flash (fast & cheap)
#   7. Groq Llama 3.1 (FREE!)
#
# Chord Generation (Cost-effective):
#   1. Groq Llama 3.1 (FREE!)
#   2. Gemini Flash (cheapest paid)
#   3. Claude Haiku (low cost)
#   4. OpenAI GPT-4o-mini (low cost)
#   5. Higher-tier models as needed
#
# If rate limit is hit on one provider, automatically tries the next!

# ===========================================
# RECOMMENDED SETUP
# ===========================================
# Minimum (Free):
#   - GROQ_API_KEY (free, covers basics)
#
# Budget-Friendly:
#   - GROQ_API_KEY (free)
#   - GEMINI_API_KEY (cheap paid option)
#
# Professional:
#   - OPENAI_API_KEY (best quality)
#   - GROQ_API_KEY (free backup)
#   - GEMINI_API_KEY (additional backup)
#
# Production:
#   - Multiple OpenAI keys (OPENAI_API_KEY, OPENAI_API_KEY_2, etc.)
#   - ANTHROPIC_API_KEY (diversity)
#   - GROQ_API_KEY (free tier as ultimate fallback)
#   - GEMINI_API_KEY (cost-effective backup)
